module program_counter(
	input logic clk,
	input logic halt,
	input logic reset,
	input logic io_stall,
	input logic btn_io,
	input logic [31:0] pc_in,
	output logic [31:0] pc_out
);
	logic halt_active;
	logic stall_active;
	logic pc_enable;
	logic btn_io_prev;
	logic btn_io_rise;

	assign pc_enable = ~(halt_active | stall_active)


	// Detecta borda
	always_ff @(posedge clk or posedge reset) begin
		if (reset)
			btn_io_prev <= 0;
		else
			btn_io_prev <= btn_io;
	end

	assign btn_io_rise = btn_io & ~btn_io_prev;

	// Stall
	always_ff @(posedge clk or posedge reset) begin
		if (reset)
			stall_active <= 0;
		else if (stall_active && btn_io_rise)
			stall_active <= 0;
		else if (~stall_active && io_stall)
			stall_active <= 1;
	end

	always_ff @(posedge clk or posedge reset) begin
		if(reset)
			pc_out <= 32'b0;
		else if(pc_enable)
			pc_out <= pc_in;
	end

endmodule