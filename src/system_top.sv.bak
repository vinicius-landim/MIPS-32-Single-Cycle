module system_top(
    input logic clk,
    input logic reset,
    input logic [15:0] switches,
    output logic [6:0] HEX6, HEX5, HEX4, HEX3, HEX2, HEX1, HEX0
);
    logic flag_out, flag_negative;
    logic [31:0] data_out;

    mips_processor mips(
        .clk(clk),
        .reset_pc(reset),
        .switches(switches),
        .data_out(data_out),
        .flag_out(flag_out),
        .flag_negative(flag_negative)
    );

    display_output display(
        .out(flag_out),
        .bin_value(data_out[19:0]),
        .HEX6(HEX6),
        .HEX5(HEX5),
        .HEX4(HEX4),
        .HEX3(HEX3),
        .HEX2(HEX2),
        .HEX1(HEX1),
        .HEX0(HEX0)
    );

endmodule